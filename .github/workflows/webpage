name: Deploy Custom Folder to Pages

on:
  push:
    branches: ["main"]
  workflow_dispatch: 

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4 # Upgraded to v4 for Node compatibility
      - name: Setup Pages
        uses: actions/configure-pages@v5 # Upgraded to support newer Node defaults
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3 # Upgraded to v3
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4 # Upgraded to v4 for Node 24 support
        with:
          path: './webpage_project' 
